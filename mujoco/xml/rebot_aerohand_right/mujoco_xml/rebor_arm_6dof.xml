<mujoco model="reBot-DevArm_gripper">
<!--  <compiler angle="radian"/>-->
  <compiler angle="radian" meshdir="assets/" inertiafromgeom="auto" inertiagrouprange="4 5" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" iterations="50" tolerance="1e-10" solver="Newton" jacobian="dense" cone="elliptic"/>

  <asset>
    <mesh name="rebot_base_link" file="../rebot_6dof/base_link.STL"/>
    <mesh name="rebot_link1" file="../rebot_6dof/link1.STL"/>
    <mesh name="rebot_link2" file="../rebot_6dof/link2.STL"/>
    <mesh name="rebot_link3" file="../rebot_6dof/link3.STL"/>
    <mesh name="rebot_link4" file="../rebot_6dof/link4.STL"/>
    <mesh name="rebot_link5" file="../rebot_6dof/link5.STL"/>

    <!-- floor -->
    <texture builtin="checker" height="100" name="texplane" rgb1="0.6 0.6 0.6" rgb2="0.8 0.8 0.8" type="2d" width="100"/>
    <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" texrepeat="60 60" texture="texplane"/>
    <!-- wood -->
    <texture type="2d" file="rebot_6dof/wood.png"/>
    <material name="wood" texture="wood"/>
    <!-- light_wood -->
    <texture type="2d" file="rebot_6dof/light_wood.png"/>
    <material name="light_wood" texture="light_wood"/>
    <!-- marble -->
    <texture type="2d" file="rebot_6dof/marble.png"/>
    <material name="marble" texture="marble"/>
    <!-- metal -->
    <texture type="2d" file="rebot_6dof/metal.png"/>
    <material name="metal" texture="metal"/>
    <!-- carpet-black -->
    <texture type="2d" file="rebot_6dof/carpet-black.png"/>
    <material name="carpet-black" texture="carpet-black"/>
    <!-- 设置天空盒纹理 -->
    <texture type="skybox" file="rebot_6dof/desert.png" gridsize="3 4" gridlayout=".U..LFRB.D.." />
  </asset>

  <default>
    <default class="rebot_joint_1">
      <joint damping="20" armature="0.04"/>
    </default>
    <default class="rebot_joint_2">
      <joint damping="18" armature="0.03"/>
    </default>
    <default class="rebot_joint_3">
      <!-- Joint 3 carries most of the distal assembly: use a more damped response. -->
      <joint damping="18" armature="0.03"/>
    </default>
    <default class="rebot_joint_4">
      <joint damping="25" armature="0.04"/>
    </default>
    <default class="rebot_joint_5">
      <joint damping="15" armature="0.02"/>
    </default>
    <default class="rebot_joint_6">
      <joint damping="15" armature="0.02"/>
    </default>

  </default>

  <visual>
    <map fogstart="1.5" fogend="5" force="0.1" znear="0.1"/>
    <quality shadowsize="4096" offsamples="4"/>
    <headlight ambient="0.4 0.4 0.4"/>
  </visual>

  <worldbody>

    <!-- rebot -->
    <body name="base_link" pos="-0.1 0 0">
      <geom type="mesh" rgba="0.62745 0.62745 0.62745 1" mesh="rebot_base_link" material="metal"/>

      <body name="link1" pos="-8.416e-05 0 0.08465">
        <inertial pos="0.000113615 -0.00061632 0.0236476" quat="0.672066 0.672066 0.219836 -0.219836" mass="0.1613" diaginertia="0.000272817 0.000213413 0.00015464"/>
        <joint name="joint1" class="rebot_joint_1" pos="0 0 0" axis="0 0 1" range="-2.8 2.8"/>
        <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="rebot_link1" material="metal"/>

        <body name="link2" pos="0.020084 0.031625 0.05555" quat="0.707105 -0.707108 0 0">
          <inertial pos="-0.132256 -0.0030617 -0.0308307" quat="0.00176765 0.707354 0.00179466 0.706855" mass="1.3266" diaginertia="0.0128139 0.0125599 0.000733734"/>
          <joint name="joint2" class="rebot_joint_2" pos="0 0 0" axis="0 0 -1" range="-3.14 0"/>
          <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="rebot_link2" material="metal"/>

          <body name="link3" pos="-0.264 0 0">
            <inertial pos="0.12104 -0.0536211 -0.0310138" quat="-0.00138181 0.704593 0.00278372 0.709605" mass="0.8353" diaginertia="0.00648251 0.00632715 0.000467564"/>
            <joint name="joint3" class="rebot_joint_3" pos="0 0 0" axis="0 0 1" range="-3.14 0"/>
            <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="rebot_link3" material="metal"/>

            <body name="link4" pos="0.2426 -0.054 -0.001625">
              <inertial pos="0.0608201 -0.0511712 -0.0302995" quat="0.619751 0.601248 0.365808 0.347267" mass="0.52" diaginertia="0.000889485 0.000667165 0.000323211"/>
              <joint name="joint4" class="rebot_joint_4" pos="0 0 0" axis="0 0 1" range="-1.87 1.57"/>
              <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="rebot_link4" material="metal"/>

              <body name="link5" pos="0.078308 -0.0375 -0.03" quat="0.707105 -0.707108 0 0">
                <inertial pos="-0.00502802 1.73866e-06 0.0386233" quat="0.644154 0.196994 0.180566 0.716697" mass="0.383" diaginertia="0.000217429 0.000212237 0.000157335"/>
                <joint name="joint5" class="rebot_joint_5" pos="0 0 0" axis="0 0 1" range="-1.57 1.57"/>
                <geom type="mesh" rgba="0.627451 0.627451 0.627451 1" mesh="rebot_link5" material="metal"/>

                <body name="link6" pos="0.028008 0 0.04" quat="0.707105 0 0.707108 0">
                  <!-- Wrist inertia is retained for stable constrained dynamics; no terminal-link mesh. -->
                  <inertial pos="5.50089e-06 -3.71802e-05 0.0578217"
                            quat="0.999981 -0.00127532 -0.000304602 -0.00594064"
                            mass="0.8663"
                            diaginertia="0.00127909 0.000983777 0.000513199"/>
                  <joint name="joint6" class="rebot_joint_6" pos="0 0 0" axis="0 0 1" range="-3.14 3.14"/>
                  <!-- Direct rigid attachment: adjust distance only in this included body's pos. -->

                  <include file="aerohand_right_body.xml"/>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

  </worldbody>

  <contact>
    <exclude body1="link1" body2="base_link"/>
    <exclude body1="link2" body2="link4"/>
    <exclude body1="link4" body2="link6"/>
  </contact>

  <actuator>
    <position ctrllimited="true" ctrlrange="-1.87 1.87" joint="joint1" kp="200" user="1" forcelimited="true" forcerange="-150 150"/>
    <position ctrllimited="true" ctrlrange="-3.14 0" joint="joint2" kp="250" user="1" forcelimited="true" forcerange="-150 150"/>
    <position ctrllimited="true" ctrlrange="-3.14 0" joint="joint3" kp="250" user="1" forcelimited="true" forcerange="-150 150"/>
    <position ctrllimited="true" ctrlrange="-1.87 1.57" joint="joint4" kp="600" user="1" forcelimited="true" forcerange="-100 100"/>
    <position ctrllimited="true" ctrlrange="-1.57 1.57" joint="joint5" kp="300" user="1" forcelimited="true" forcerange="-100 100"/>
    <position ctrllimited="true" ctrlrange="-3.14 3.14" joint="joint6" kp="300" user="1" forcelimited="true" forcerange="-100 100"/>
  </actuator>

</mujoco>
